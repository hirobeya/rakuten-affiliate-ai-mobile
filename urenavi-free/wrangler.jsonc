{
  "name": "urenavi-free-qa-191",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  }
}
