{
  "version": 2,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "node reconcile-once.cjs && node preflight-readonly.cjs",
  "env": { "URENAVI_CALIBRATION_ISOLATED_PREVIEW": "1", "URENAVI_CALIBRATION_LIVE": "disabled", "URENAVI_COMPARISON_LIVE": "disabled" },
  "functions": { "api/calibration.js": { "maxDuration": 60 } },
  "headers": [ { "source": "/(.*)", "headers": [
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'" }
  ] } ]
}
