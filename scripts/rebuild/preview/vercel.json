{
  "version": 2,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "",
  "env": { "URENAVI_CALIBRATION_ISOLATED_PREVIEW": "1" },
  "functions": { "api/calibration.js": { "maxDuration": 60 } },
  "headers": [ { "source": "/(.*)", "headers": [
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'" }
  ] } ]
}
